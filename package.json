{
  "name": "@neovici/cosmoz-slideout",
  "version": "0.0.0",
  "description": "A reusable top-layer slideout / drawer web component built with pionjs and lit-html",
  "keywords": [
    "web-components",
    "slideout",
    "drawer",
    "sidebar",
    "dialog",
    "pion",
    "lit-html"
  ],
  "homepage": "https://github.com/Neovici/cosmoz-slideout#readme",
  "bugs": {
    "url": "https://github.com/Neovici/cosmoz-slideout/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Neovici/cosmoz-slideout.git"
  },
  "license": "Apache-2.0",
  "author": "Neovici Development",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "lint": "tsc && eslint --cache .",
    "check:duplicates": "check-duplicate-components",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "changeset": "changeset",
    "start": "wds",
    "test": "vitest --run",
    "test:unit": "vitest --project=unit --run",
    "test:storybook": "vitest --project=storybook --run",
    "test:watch": "vitest",
    "storybook:start": "storybook dev -p 8000",
    "storybook:build": "storybook build",
    "storybook:deploy": "storybook-to-ghpages",
    "storybook:preview": "npm run storybook:build && http-server ./storybook-static/ --silent",
    "prepare": "husky"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cosmoz-slideout": {
      "types": "./dist/cosmoz-slideout.d.ts",
      "default": "./dist/cosmoz-slideout.js"
    },
    "./cosmoz-slideout-panel": {
      "types": "./dist/cosmoz-slideout-panel.d.ts",
      "default": "./dist/cosmoz-slideout-panel.js"
    },
    "./use-close": {
      "types": "./dist/use-close.d.ts",
      "default": "./dist/use-close.js"
    },
    "./use-full-screen": {
      "types": "./dist/use-full-screen.d.ts",
      "default": "./dist/use-full-screen.js"
    }
  },
  "dependencies": {
    "@neovici/cosmoz-button": "^1.1.1",
    "@neovici/cosmoz-icons": "^1.3.0",
    "@neovici/cosmoz-tokens": "^3.5.0",
    "@neovici/cosmoz-utils": "^6.17.0",
    "@pionjs/pion": "^2.5.2",
    "lit-html": "^3.3.1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@neovici/cfg": "^2.8.0",
    "@neovici/cosmoz-bottom-bar": "^11.1.1",
    "@neovici/cosmoz-input": "^5.8.0",
    "@neovici/testing": "^2.3.0",
    "@playwright/test": "1.61.1",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.2.4",
    "@storybook/web-components-vite": "^10.2.4",
    "@types/node": "^26.1.1",
    "@vitest/browser": "^4.0.18",
    "@vitest/browser-playwright": "^4.0.18",
    "eslint": "^10.6.0",
    "http-server": "^14.1.1",
    "husky": "^9.0.0",
    "jsdom": "^29.0.1",
    "lint-staged": "^17.0.7",
    "shadow-dom-testing-library": "^1.13.1",
    "sinon": "^22.0.0",
    "storybook": "^10.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "conventional-changelog-conventionalcommits": ">= 8.0.0"
  }
}
